---
layout: layouts/base.njk
---
{% set nxt = collections.guides | nextGuide(page.url) %}
<article>
  <div class="art-head">
    <p><a class="back-link" href="/guides/">&larr; All guides</a></p>
    <h1>{{ title }}</h1>
    <p class="dek">{{ description }}</p>
    <p class="art-meta">{{ page.date | readableDate }} &middot; Game Night Guide &middot; Last checked {{ site.lastChecked }}</p>
  </div>
  {% if photo %}
  <figure class="art-hero">
    <img src="{{ photo }}" alt="{{ imageAlt or title }}" width="1200" height="675" loading="eager">
    <figcaption>Photo: see <a href="/photo-credits/">photo credits</a>.</figcaption>
  </figure>
  {% elif image %}
  <figure class="art-hero">
    <img src="{{ image }}" alt="{{ imageAlt or title }}" width="1200" height="675" loading="eager">
    <figcaption>Photo: see <a href="/photo-credits/">photo credits</a>.</figcaption>
  </figure>
  {% endif %}
  <div class="art-body">
    {{ content | safe }}
    <hr>
    <p><a href="/finder/">Try the Board Game Finder &rarr;</a> &middot; <a href="/guides/">All guides &rarr;</a></p>
  </div>
  {% if nxt and nxt.url != page.url %}
  <div class="next-box">
    <span class="smallcaps">Read next</span>
    <p class="t"><a href="{{ nxt.url }}">{{ nxt.data.title }}</a></p>
  </div>
  {% endif %}
</article>
